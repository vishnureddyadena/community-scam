# =========================================================================
# ScamRadar India - Comprehensive .gitignore
# =========================================================================

# Environment and Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Databases and Local Storage (Never commit local database files)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/scamradar.db
test_scamradar.db

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Next.js telemetry & cache
.turbo/
next-env.d.ts

# Agentic Skills & Agent Workspaces
.agents/
skills-lock.json


