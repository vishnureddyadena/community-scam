# ==========================================
# ScamRadar India — Backend Environment Variables
# ==========================================

# Port (injected automatically by Render, Railway, Heroku; defaults to 8000)
PORT=8000

# Environment: "production" or "development"
ENVIRONMENT=production

# Database URL
# For SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///scamradar.db
# For PostgreSQL / Supabase / Neon:
# DATABASE_URL=postgresql://postgres.xxx:yyy@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# License check bypass for cloud deployment:
DISABLE_LICENSE_CHECK=true

# Admin Reset Flag
ENABLE_ADMIN_RESET=true

# Supabase Auth Configuration (for Admin portal)
SUPABASE_URL=https://psvmzqigzpvzbggrmhvw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Security Keys
HMAC_SECRET_KEY=scamradar-super-secret-hmac-key-2026
